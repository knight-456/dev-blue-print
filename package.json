{
  "name": "create-devblueprint",
  "version": "1.0.1",
  "description": "Create React, Vite, and Next.js projects with a modular CLI, selectable integrations, and feature-based architecture.",
  "type": "module",
  "bin": {
    "create-devblueprint": "./dist/cli.js",
    "devblueprint": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/knight-456/dev-blue-print"
  },
  "homepage": "https://github.com/knight-456/dev-blue-print#readme",
  "bugs": {
    "url": "https://github.com/knight-456/dev-blue-print/issues"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react-project-generator",
    "react-boilerplate",
    "react-starter",
    "vite-starter",
    "nextjs-starter",
    "project-generator",
    "starter-template",
    "cli",
    "scaffolding",
    "react",
    "vite",
    "nextjs",
    "typescript",
    "feature-based-architecture",
    "redux",
    "tanstack-query"
  ],
  "author": "DevBlueprint Team",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.8.7",
    "esbuild": "^0.28.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
